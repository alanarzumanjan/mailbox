{
  "name": "emptyless-backend",
  "version": "1.0.0",
  "private": true,
  "description": "EmptyLess / EmptyLess backend: smart postbox telemetry, events, pickups and courier routing",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
