# Скопировать в .env и поменять значения. Все параметры — в src/config.js.

PORT=4000
LOG_LEVEL=info

# При запуске через docker compose перекрывается на mongodb://mongo:27017/emptyless.
# Для Mongo Atlas: mongodb+srv://<user>:<password>@<cluster>/emptyless
MONGODB_URI=mongodb://localhost:27017/emptyless

# Откуда фронт ходит в API. * — все (только для разработки).
CORS_ORIGINS=http://localhost:3000,https://smart-postbox.vercel.app
# true, если API стоит за прокси/балансировщиком (Render, Railway, nginx)
TRUST_PROXY=false

# --- Авторизация ---
# Обязателен в production, минимум 32 символа: openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12
# OAuth Client ID из Google Cloud Console (вход через Google). Пусто — выключено.
GOOGLE_CLIENT_ID=

# --- Датчики ---
DEVICE_OFFLINE_MINUTES=30
MONITOR_INTERVAL_SEC=60
# Сколько дней хранить сырые показания. 0 — не удалять.
READING_RETENTION_DAYS=30

# --- Уведомления о критических событиях (оба канала необязательны) ---
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=EmptyLess <onboarding@resend.dev>
# Slack/Teams incoming webhook или любой HTTP-приёмник
ALERT_WEBHOOK_URL=

# Демо-кнопка /api/simulate/mail. В production выключить.
ENABLE_SIMULATION=true

# --- Экономическая модель для /api/analytics/savings ---
FUEL_L_PER_100KM=9
FUEL_PRICE_EUR=1.6
AVG_SPEED_KMH=25
STOP_MINUTES=3
