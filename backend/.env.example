# Copy to .env and adjust. All settings are described in src/config.js.

PORT=4000
LOG_LEVEL=info

# Overridden to mongodb://mongo:27017/emptyless when running via docker compose.
# For Mongo Atlas: mongodb+srv://<user>:<password>@<cluster>/emptyless
MONGODB_URI=mongodb://localhost:27017/emptyless

# Origins allowed to call the API. * allows all (development only).
CORS_ORIGINS=http://localhost:3000,https://smart-postbox.vercel.app
# true if the API sits behind a proxy/load balancer (Render, Railway, nginx)
TRUST_PROXY=false

# --- Authentication ---
# Required in production, at least 32 characters: openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12
# OAuth Client ID from Google Cloud Console (Google sign-in). Empty disables it.
GOOGLE_CLIENT_ID=

# --- Sensors ---
DEVICE_OFFLINE_MINUTES=30
MONITOR_INTERVAL_SEC=60
# How many days to keep raw sensor readings. 0 means never delete.
READING_RETENTION_DAYS=30

# --- Critical event notifications (both channels optional) ---
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=EmptyLess <onboarding@resend.dev>
# Slack/Teams incoming webhook or any HTTP receiver
ALERT_WEBHOOK_URL=

# Demo button /api/simulate/mail. Disable in production.
ENABLE_SIMULATION=true

# --- Economic model for /api/analytics/savings ---
FUEL_L_PER_100KM=9
FUEL_PRICE_EUR=1.6
AVG_SPEED_KMH=25
STOP_MINUTES=3
